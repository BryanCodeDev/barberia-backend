    "morgan": "^1.10.0",
    "mysql2": "^3.6.19",
    "node-cron": "^3.0.3",
    "pm2": "^5.4.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
